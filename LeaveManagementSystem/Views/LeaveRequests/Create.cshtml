@model LeaveRequestCreateVM
@{

    ViewData["Title"] = "Create a Leave Request";
}
<h1>Create</h1>

<h4>Leave Request</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="StarDate" class="control-label"></label>
                <input asp-for="StarDate" class="form-control" />
                <span asp-validation-for="StarDate" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="EndDate" class="control-label"></label>
                <input asp-for="EndDate" class="form-control" />
                <span asp-validation-for="StarDate" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="LeaveTypeId" class="control-label"></label>
                <select asp-for="LeaveTypeId" class="form-select" asp-items="Model.LeaveTypes"></select>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Comments" class="control-label"></label>
                <textarea asp-for="Comments" class="form-control"></textarea>
                <span asp-validation-for="Comments" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-success"/>
                <a asp-controller="LeaveAllocation" asp-action="Details" class="btn btn-danger">Cancel</a>
                <a asp-action="Index" class="btn btn-warning">Back to Index</a>
            </div>

        </form>
    </div>
</div>
@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");

                <script>
                    $(function () {
                        $("#StarDate").datepicker({
                            dateFormat:'yy-mm-dd',
                            changeMonth: true,
                            changeYear: true
                        });
                        $("#EndDate").datepicker({
                            dateFormat: 'yy-mm-dd',
                            changeMonth: true,
                            changeYear: true
                        });
                    });
                </script>
    }
}

